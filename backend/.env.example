# =============================================================================
# Nishmat AI — backend environment
#
# Copy to `backend/.env` and fill in. That file is gitignored.
# NOTHING in here may ever appear in the frontend bundle.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# ---- Supabase ---------------------------------------------------------------
# Project URL — same value as NEXT_PUBLIC_SUPABASE_URL in the frontend.
SUPABASE_URL=

# Anon key — same as the frontend. Used for operations that should respect RLS.
SUPABASE_ANON_KEY=

# Service-role / secret key.
#
# Supabase dashboard → Settings → API Keys → "Secret keys" → the `default` row.
# Newer projects show this as `sb_secret_...`; older ones show a JWT under the
# "Legacy anon, service_role API keys" tab. Either works — they are the same
# privilege level under different naming.
#
# THIS BYPASSES ROW LEVEL SECURITY. Backend and scripts only. Never the browser,
# never a log line, never a git commit.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — Settings → Database → Connection string (URI).
# Only needed for running migrations from the CLI. Optional.
SUPABASE_DB_URL=

# Private bucket for uploaded source material.
SUPABASE_STORAGE_BUCKET=source-files

# ---- OpenAI -----------------------------------------------------------------
# The client's key. Backend only.
OPENAI_API_KEY=

# Model IDs are configuration, not code. Confirm which models the client's key
# actually has access to before pinning these.
OPENAI_MODEL_ANALYSIS=
OPENAI_MODEL_GENERATION=
OPENAI_MODEL_MODIFICATION=
OPENAI_MODEL_QUALITY=
OPENAI_MODEL_CHAT=
OPENAI_MODEL_UTILITY=
OPENAI_MODEL_VISION=
OPENAI_MODEL_TRANSCRIPTION=
OPENAI_MODEL_EMBEDDING=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=120

# ---- Budget guardrails ------------------------------------------------------
# The client's total OpenAI budget is fixed at $10. These are enforced in code,
# not by convention.

# mock  = replay recorded fixtures, zero cost (use while building)
# live  = real API calls
LLM_MODE=mock

# Hard ceiling. The LLM service sums `ai_usage.estimated_cost` and REFUSES any
# further call once the total passes this. Raises, does not warn.
AI_SPEND_CAP_USD=8.00

# Warn in the admin UI once spend passes this.
AI_SPEND_WARN_USD=5.00

# ---- Upload limits ----------------------------------------------------------
MAX_UPLOAD_MB_DOCUMENT=25
MAX_UPLOAD_MB_IMAGE=10
MAX_UPLOAD_MB_AUDIO=100

# ---- Background worker ------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=3
WORKER_MAX_ATTEMPTS=3
GENERATION_MAX_AUTO_RETRIES=1

# ---- Retrieval / chat -------------------------------------------------------
RAG_TOP_K=6
RAG_MIN_SCORE=0.25
CHAT_HISTORY_WINDOW=8
CHAT_SUMMARY_THRESHOLD=16
