# Supabase — safe to expose to the browser (anon key is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public site URL — used for OAuth redirects. Must match the redirect URL
# configured in Supabase Auth settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put OPENAI_API_KEY or SUPABASE_SERVICE_ROLE_KEY in this file.
